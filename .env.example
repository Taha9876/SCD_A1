# Copy to .env and fill in. .env is gitignored and must NEVER be committed:
# a credential in Git history is a -20 mark deduction plus a rotation you then
# have to explain in an incident note. Base64 is not encryption either.
#
#   cp .env.example .env

# --- Database -------------------------------------------------------------
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-before-you-run-anything
POSTGRES_DB=civicpulse
POSTGRES_PORT=5432

# --- Cache ----------------------------------------------------------------
REDIS_PORT=6379

# --- Ports ----------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Triage provider ------------------------------------------------------
# One of: rules | simulated | llm | ollama
#   rules      keyword fallback. No key, no network. Works out of the box.
#   simulated  deterministic fake. What CI uses.
#   llm        hosted model over an OpenAI-compatible endpoint (Groq default).
#   ollama     local container, no key, no network. `--profile ai`.
TRIAGE_PROVIDER=rules

# Free tier, no credit card: sign up at https://console.groq.com and paste the
# key here. Leave blank unless TRIAGE_PROVIDER=llm -- the app refuses to start
# with provider=llm and an empty key rather than failing as a 401 in front of
# a citizen.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

OLLAMA_MODEL=llama3.2:1b

# --- Rate limiting --------------------------------------------------------
# Deliberately low: the free LLM tier is measured in tens of requests per
# minute, and one bored user with a for loop exhausts a whole day of quota.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# --- Production only (compose.prod.yaml) ----------------------------------
# Owner/repo for the GHCR image path, e.g. your-team/civicpulse
GITHUB_REPOSITORY=
# An immutable reference: a commit SHA or a digest. Never `latest`.
IMAGE_TAG=
CORS_ORIGINS=http://localhost
